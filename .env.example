# ============================================================
# PhishGuard AI - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# ── Security ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./phishguard.db

# ── Model Paths (defaults shown, override only if you move files) ──
# MODEL_PATH=models/distilbert_gat/deployment/distilbert_gat_best.pt
# GRAPH_PATH=models/distilbert_gat/deployment/graph_data.pt
# EMBEDDINGS_PATH=models/distilbert_gat/deployment/train_embeddings.pt
# REFERENCE_PATH=models/distilbert_gat/deployment/reference_emails.csv
# TOKENIZER_PATH=models/distilbert_gat/deployment/tokenizer

# ── Classification Threshold ─────────────────────────────────
CLASSIFICATION_THRESHOLD=0.47
RISK_MEDIUM_THRESHOLD=0.47
RISK_HIGH_THRESHOLD=0.60
RISK_CRITICAL_THRESHOLD=0.80

# ── CORS Origins ──────────────────────────────────────────────
# Add your Chrome Extension ID after loading it unpacked:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://YOUR_EXTENSION_ID
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development
