{
  "manifest_version": 3,
  "name": "PhishGuard AI",
  "version": "1.0.0",
  "description": "Enterprise Phishing Detection & SOC Platform Extension",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/api_client.js"
  },
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*", "*://*/*"],
      "js": [
        "content/extractors/gmail.js",
        "content/extractors/generic.js",
        "content/content.js"
      ]
    }
  ]
}
